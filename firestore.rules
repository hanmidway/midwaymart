rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'quickreload01@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.wholesalePrice is number && data.wholesalePrice >= 0
        && data.stock is number && data.stock >= 0
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 30
        && (!('price' in data) || (data.price is number && data.price >= 0))
        && (!('minWholesaleQty' in data) || (data.minWholesaleQty is number && data.minWholesaleQty >= 1))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 50));
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 25
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['pending', 'confirmed', 'shipped', 'completed', 'cancelled']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && (!('customerAddress' in data) || (data.customerAddress is string && data.customerAddress.size() <= 300))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Products collection:
    // Anyone in the public can view catalog items
    // Only the store owner / admin can create, update, or delete products
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Orders collection:
    // Anyone can place a wholesale order
    // Order creator or admin can view order
    // Only admin can update status or delete
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Admins collection:
    // Only logged-in users can check their own admin doc
    // Only existing admin can manage admins
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminUid);
    }
  }
}
